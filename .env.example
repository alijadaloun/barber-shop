# Firebase Admin (server)
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
# FIREBASE_PROJECT_ID=mohtades-shop
# FIRESTORE_DATABASE_ID=(default)

# Resend (email on appointment acceptance)
# https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=re_your_api_key
# Production: use a verified domain, e.g. Mohtade's Shop <bookings@yourdomain.com>
# Dev/test only: Mohtade's Shop <onboarding@resend.dev> (sends ONLY to your Resend account email)
RESEND_FROM_EMAIL=Mohtade's Shop <onboarding@resend.dev>
# Optional: npm run test:resend sends to this address
RESEND_TEST_TO=your-resend-account@gmail.com

# Admin Authentication
JWT_SECRET=your_super_secret_key
ADMIN_EMAIL=admin@mohtade.com
ADMIN_PASSWORD=your_secure_pass
